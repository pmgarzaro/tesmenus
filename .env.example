# Optionnel : secret de signature des cookies de session.
# Sans valeur, un secret aléatoire est généré et gardé dans DATA_DIR/session-secret.
SESSION_SECRET=
# Dossier contenant la base SQLite et les images uploadées
DATA_DIR=./data
# Optionnel : IA Google Gemini (clé gratuite sur https://aistudio.google.com/apikey).
# Sans clé, l'appli utilise uniquement ses règles locales.
GEMINI_API_KEY=
# Optionnel : modèle(s) à essayer en premier, séparés par des virgules
# (sinon plusieurs modèles Flash / Flash-Lite sont essayés dans l'ordre)
GEMINI_MODEL=
# Optionnel : adresse publique de l'appli (métadonnées OAuth du serveur MCP /mcp).
# Sans valeur, elle est déduite des en-têtes X-Forwarded-* de la requête.
PUBLIC_URL=
# Optionnel : jeton statique pour /mcp (≥ 32 caractères aléatoires, jamais dans le dépôt)
# et e-mail du compte pour lequel il agit. Inutile pour claude.ai (OAuth).
MCP_TOKEN=
MCP_TOKEN_EMAIL=
