# Optionnel : secret de signature des cookies de session.
# Sans valeur, un secret aléatoire est généré et gardé dans DATA_DIR/session-secret.
SESSION_SECRET=
# Dossier contenant la base SQLite et les images uploadées
DATA_DIR=./data
# Optionnel : IA Google Gemini (clé gratuite sur https://aistudio.google.com/apikey).
# Sans clé, l'appli utilise uniquement ses règles locales.
GEMINI_API_KEY=
# Optionnel : modèle (défaut gemini-flash-latest)
GEMINI_MODEL=
